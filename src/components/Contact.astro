<!-- BEGIN: Conversion Lead Banner -->
<section
  class="py-24 bg-[#12131C] relative overflow-hidden"
  data-purpose="lead-banner"
  id="contacto"
  style="background: radial-gradient(circle at 50% 50%, rgba(55, 25, 38, 0.6) 0%, rgba(14, 15, 23, 0.95) 80%);"
>
  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-brand-lima text-xs font-mono mb-6"
    >
      <span>Primer paso hacia la automatización</span>
    </div>
    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-light tracking-tight text-white mb-6 text-balance">
      Cuéntanos qué debería hacer <br />
      <span class="italic font-serif text-brand-lima">la IA por tu negocio.</span>
    </h2>
    <p class="text-brand-muted text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
      Una conversación técnica de 20 minutos para entender tus procesos, valorar si tiene sentido aplicar IA y
      proponerte una ruta clara de acción sin rodeos.
    </p>
    <!-- Direct Email / Booking CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
      <a
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-brand-lima hover:bg-brand-lima-hover text-brand-midnight font-bold text-sm transition-all duration-200 shadow-xl shadow-brand-lima/20"
        href="mailto:hola@quantumfactory.io"
      >
        <span>Agendar diagnóstico gratuito</span>
        <span>→</span>
      </a>
      <a
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-full bg-white/5 hover:bg-white/10 text-white text-sm font-medium border border-white/10 transition-colors"
        href="/servicios"
      >
        <span>Ver catálogo (12)</span>
      </a>
    </div>
    <div class="mt-8 text-xs font-mono text-brand-muted/70 flex items-center justify-center gap-4">
      <span>✓ Respuesta en &lt; 24h</span>
      <span>•</span>
      <span>✓ Sin compromiso de contratación</span>
      <span>•</span>
      <span>✓ NDA bajo petición</span>
    </div>
  </div>
</section>
<!-- END: Conversion Lead Banner -->
