---
const quadrants = [
  {
    pad: 'md:pr-10 md:pb-12',
    titleHover: 'group-hover:text-brand-lima',
    title: 'Código 100% Propietario',
    dot: 'bg-brand-lima',
    items: [
      'Sin suscripciones cautivas',
      'Activo exclusivo transferido',
      'Autonomía tecnológica total',
      'Repositorios confidenciales',
    ],
  },
  {
    pad: 'md:pl-10 md:pb-12',
    titleHover: 'group-hover:text-brand-coral',
    title: 'Despliegue Europeo & RGPD',
    dot: 'bg-brand-coral',
    items: [
      'Servidores con soberanía europea',
      'Cumplimiento estricto RGPD',
      'Adaptado al AI Act UE',
      'Zero-data leakage',
    ],
  },
  {
    pad: 'md:pr-10 md:pt-12',
    titleHover: 'group-hover:text-amber-300',
    title: 'Retorno Medible',
    dot: 'bg-amber-400',
    items: [
      'Métricas de negocio tangibles',
      'Horas manuales cuantificadas',
      'Reducción directa de costes',
      'Auditoría económica previa',
    ],
  },
  {
    pad: 'md:pl-10 md:pt-12',
    titleHover: 'group-hover:text-cyan-200',
    title: 'Soporte & Integración',
    dot: 'bg-cyan-400',
    items: [
      'Integración en tus sistemas',
      'Soporte directo · L–V 9–19',
      'Controles antes de producción',
      'Escalabilidad sin vendor-lock',
    ],
  },
];
---

<!-- BEGIN: Differentials & Compliance -->
<section
  class="py-20 sm:py-28 bg-[#090A0F] text-white relative overflow-hidden"
  data-purpose="differentials"
  id="diferenciales"
  style="background: radial-gradient(circle at 75% 50%, rgba(185, 65, 45, 0.18) 0%, rgba(120, 35, 30, 0.08) 45%, rgba(9, 10, 15, 0.98) 75%), rgb(9, 10, 15);"
>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <!-- Left Column -->
      <div class="lg:col-span-4 flex flex-col justify-between pt-2">
        <div>
          <h2
            class="text-4xl sm:text-5xl lg:text-[3.25rem] font-bold tracking-tight text-white leading-[1.08] mb-6 font-display text-balance"
          >
            Por qué elegir <br />
            <span class="text-brand-coral">Quantum Factory</span>
          </h2>
          <p class="text-neutral-400 text-sm leading-relaxed max-w-sm font-normal mb-8">
            Ingeniería de inteligencia artificial diseñada sin ataduras. Construimos activos propietarios que potencian
            tus operaciones con rigor enterprise europeo.
          </p>
        </div>
        <div class="pt-8 border-t border-white/10 hidden lg:block">
          <div class="text-xs text-brand-muted leading-relaxed">
            Producción soberana, propiedad intelectual íntegra y soporte directo de ingeniería.
          </div>
        </div>
      </div>
      <!-- Right Column: 4 Quadrants -->
      <div class="lg:col-span-8 relative">
        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 divide-white/10 relative -mx-5 sm:mx-0">
          <!-- Separators -->
          <div class="hidden md:block absolute left-0 right-0 top-1/2 h-[1px] bg-white/15 z-10 pointer-events-none"></div>
          <div class="hidden md:block absolute top-0 bottom-0 left-1/2 w-[1px] bg-white/15 z-10 pointer-events-none"></div>
          {
            quadrants.map((q) => (
              <div class={`px-5 py-7 sm:p-8 ${q.pad} group hover:bg-white/[0.02] transition-colors duration-300 relative`}>
                <h3 class={`text-xl sm:text-2xl font-bold text-white mb-4 tracking-tight ${q.titleHover} transition-colors`}>
                  {q.title}
                </h3>
                <ul class="space-y-2.5 text-sm text-neutral-300 font-sans">
                  {q.items.map((item) => (
                    <li class="flex items-center gap-2.5">
                      <span class={`w-1 h-1 rounded-full ${q.dot}`} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: Differentials & Compliance -->
