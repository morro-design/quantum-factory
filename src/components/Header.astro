---
import { services, serviceUrl } from '../data/services';

const logoSrc = '/logo-lima.svg';
const primaryLinks = [
  { label: 'Método', href: '/#metodo' },
  { label: 'Por qué QF', href: '/#diferenciales' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<!-- BEGIN: Navigation Header -->
<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/[0.06] bg-brand-midnight/90 backdrop-blur-md pt-[env(safe-area-inset-top,0px)]"
  data-site-header
>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 h-16 lg:h-20 flex items-center justify-between gap-4">
    <!-- Brand Logo Left -->
    <a class="flex items-center gap-3 group shrink-0 min-h-[44px]" data-purpose="site-logo" href="/">
      <img
        alt="Quantum Factory"
        class="h-6 w-auto object-contain transition-opacity group-hover:opacity-90"
        src={logoSrc}
      />
      <span
        class="hidden xl:inline-block text-[11px] uppercase tracking-widest text-brand-muted font-mono border-l border-white/10 pl-3"
        >Boutique AI · Data</span
      >
    </a>
    <!-- Center Minimalist Navigation Links (pointer + keyboard; ≥ lg) -->
    <nav class="hidden lg:flex items-center gap-9 text-sm font-medium text-brand-muted tracking-tight" aria-label="Principal">
      <div class="relative group py-2" data-services-menu>
        <button
          class="flex items-center gap-1.5 min-h-[44px] hover:text-white group-[.is-open]:text-white transition-colors duration-200 text-sm font-medium text-brand-muted tracking-tight focus:outline-none focus-visible:text-white focus-visible:ring-2 focus-visible:ring-brand-lima/60 rounded-md px-1 -mx-1"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="services-menu-panel"
        >
          <span>Servicios</span>
          <svg
            class="w-3.5 h-3.5 text-brand-muted group-hover:text-brand-lima group-[.is-open]:text-brand-lima transition-transform duration-200 group-hover:rotate-180 group-[.is-open]:rotate-180"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </button>
        <div
          class="absolute left-0 top-full pt-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-[.is-open]:opacity-100 group-[.is-open]:pointer-events-auto transition-all duration-200 z-50 w-[580px] -ml-16"
          id="services-menu-panel"
        >
          <div class="p-4 rounded-2xl bg-[#0C0D13]/95 backdrop-blur-md border border-white/10 shadow-2xl">
            <div
              class="text-[11px] font-mono tracking-widest uppercase text-brand-lima px-3 py-1 mb-2 border-b border-white/5 flex items-center justify-between"
            >
              <span>Catálogo de Soluciones</span>
              <span class="text-white/40 font-mono">12 Capacidades</span>
            </div>
            <div class="grid grid-cols-2 gap-1">
              {
                services.map((s, i) => (
                  <a
                    class="flex items-start gap-2.5 p-2 rounded-lg hover:bg-white/5 focus-visible:bg-white/5 focus-visible:outline-none transition-colors group/item"
                    href={serviceUrl(s.slug)}
                  >
                    <span class="text-[11px] font-mono text-brand-lima/70 group-hover/item:text-brand-lima mt-0.5">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <div>
                      <div class="text-xs font-medium text-white group-hover/item:text-brand-lima transition-colors">
                        {s.title}
                      </div>
                    </div>
                  </a>
                ))
              }
            </div>
            <a
              class="mt-2 flex items-center justify-between px-3 py-2 rounded-lg text-[11px] font-mono uppercase tracking-wider text-brand-muted hover:text-brand-lima hover:bg-white/5 transition-colors"
              href="/servicios"
            >
              <span>Ver el catálogo completo</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
      {
        primaryLinks.map((l) => (
          <a class="hover:text-white transition-colors duration-200 py-2 focus-visible:outline-none focus-visible:text-white" href={l.href}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <!-- Action Button Right + Mobile Menu Trigger -->
    <div class="flex items-center gap-2 sm:gap-4">
      <a
        class="hidden sm:inline-flex items-center gap-2 min-h-[44px] text-xs font-semibold px-5 py-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/15 transition-all duration-200 hover:border-brand-lima hover:text-brand-lima whitespace-nowrap"
        href="/#contacto"
      >
        <span>Agendar diagnóstico</span>
        <span class="w-1.5 h-1.5 rounded-full bg-brand-lima animate-pulse"></span>
      </a>
      <button
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 rounded-full text-white hover:bg-white/10 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-lima/60"
        type="button"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="relative block w-5 h-3.5" aria-hidden="true">
          <span
            class="menu-bar absolute left-0 top-0 h-[1.5px] w-full bg-current rounded-full transition-transform duration-300 origin-center"
          ></span>
          <span
            class="menu-bar absolute left-0 bottom-0 h-[1.5px] w-full bg-current rounded-full transition-transform duration-300 origin-center"
          ></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile / tablet drawer: a sibling of the header, since its backdrop-filter would become the containing block for a fixed child -->
<div
  class="lg:hidden fixed inset-x-0 bottom-0 top-[calc(4rem+env(safe-area-inset-top,0px))] z-40 bg-brand-midnight/95 backdrop-blur-xl border-t border-white/[0.06] overflow-y-auto overscroll-contain opacity-0 pointer-events-none translate-y-2 transition-[opacity,transform] duration-300 ease-out data-[open]:opacity-100 data-[open]:pointer-events-auto data-[open]:translate-y-0"
  id="mobile-menu"
  data-mobile-menu
>
  <nav class="max-w-7xl mx-auto px-5 sm:px-6 pt-6 pb-[max(2rem,env(safe-area-inset-bottom,0px))] flex flex-col min-h-full" aria-label="Menú móvil">
    <ul class="space-y-1">
      {
        primaryLinks.map((l) => (
          <li>
            <a
              class="flex items-center justify-between py-4 text-2xl font-light tracking-tight text-white border-b border-white/[0.08] hover:text-brand-lima transition-colors"
              href={l.href}
            >
              <span>{l.label}</span>
              <span class="text-brand-muted text-base" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8">
      <div class="flex items-center justify-between pb-3 mb-2 border-b border-white/[0.08]">
        <a class="text-2xl font-light tracking-tight text-white hover:text-brand-lima transition-colors py-1" href="/servicios">
          Servicios
        </a>
        <span class="text-[11px] font-mono uppercase tracking-widest text-brand-lima">12 líneas</span>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
        {
          services.map((s, i) => (
            <li>
              <a
                class="flex items-baseline gap-3 py-2.5 text-sm text-neutral-300 hover:text-white transition-colors"
                href={serviceUrl(s.slug)}
              >
                <span class="text-[11px] font-mono text-brand-lima/70 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span>{s.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-auto pt-8">
      <a
        class="flex items-center justify-center gap-3 w-full min-h-[52px] px-8 py-4 rounded-full bg-brand-lima text-brand-midnight font-bold text-sm tracking-tight hover:bg-brand-lima-hover transition-colors shadow-lg shadow-brand-lima/20"
        href="/#contacto"
      >
        <span>Agendar diagnóstico gratuito</span>
        <span aria-hidden="true">→</span>
      </a>
      <div class="mt-4 flex items-center justify-center gap-3 text-[11px] font-mono text-brand-muted/80">
        <span>Respuesta en &lt; 24h</span>
        <span aria-hidden="true">·</span>
        <span>Sin compromiso</span>
      </div>
    </div>
  </nav>
</div>
<!-- END: Navigation Header -->

<style>
  /* Hamburger → close: bars collapse to the centre and cross */
  [data-menu-toggle][aria-expanded='true'] .menu-bar:first-child {
    transform: translateY(6px) rotate(45deg);
  }
  [data-menu-toggle][aria-expanded='true'] .menu-bar:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-mobile-menu]');

  const setOpen = (open: boolean) => {
    if (!toggle || !drawer) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    if (open) drawer.setAttribute('data-open', '');
    else drawer.removeAttribute('data-open');
    document.documentElement.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  drawer?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  // Drawer is for < lg only; drop its state when the viewport crosses into desktop.
  const lg = window.matchMedia('(min-width: 1024px)');
  lg.addEventListener('change', (e) => e.matches && setOpen(false));

  // Desktop "Servicios" menu: hover for pointers, tap/click + keyboard for everything else.
  const servicesMenu = header?.querySelector<HTMLElement>('[data-services-menu]');
  const servicesButton = servicesMenu?.querySelector<HTMLButtonElement>('button');
  const setServicesOpen = (open: boolean) => {
    servicesMenu?.classList.toggle('is-open', open);
    servicesButton?.setAttribute('aria-expanded', String(open));
  };
  servicesButton?.addEventListener('click', () => setServicesOpen(!servicesMenu!.classList.contains('is-open')));
  document.addEventListener('click', (e) => {
    if (servicesMenu && !servicesMenu.contains(e.target as Node)) setServicesOpen(false);
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      setOpen(false);
      setServicesOpen(false);
    }
  });
</script>
