---
import { families, familyOrder, servicesByFamily, serviceUrl } from '../data/services';
---

<section class="py-20 sm:py-28 bg-white text-neutral-800" data-purpose="services-catalog" id="servicios">
  <div class="max-w-7xl mx-auto px-5 sm:px-6">
    <div class="max-w-3xl mb-12 sm:mb-16">
      <h2 class="text-3xl sm:text-5xl font-light tracking-tight text-neutral-800 mb-4 text-balance">
        Servicios
      </h2>
      <p class="text-neutral-600 text-base sm:text-lg font-light leading-relaxed max-w-2xl text-balance">
        Las doce líneas, con el mismo código QF·NN de la propuesta. Propiedad del código, despliegue europeo y el diagnóstico antes de construir.
      </p>
    </div>

    <div class="space-y-14 sm:space-y-16">
      {
        familyOrder.map((key) => {
          const fam = families[key];
          const list = servicesByFamily(key);
          return (
            <div>
              <div class="flex items-center gap-4 pb-4 border-b border-black/[0.08]">
                <span
                  class={`w-10 h-10 shrink-0 rounded-2xl bg-brand-midnight ${fam.text} font-display text-lg font-medium flex items-center justify-center`}
                >
                  {fam.key}
                </span>
                <div class="min-w-0">
                  <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-neutral-800">{fam.name}</h3>
                  <p class="text-[0.6875rem] font-mono uppercase tracking-widest text-neutral-500 mt-0.5">
                    {list.length} líneas
                  </p>
                </div>
              </div>
              <ul>
                {list.map((s) => (
                  <li class="border-b border-black/[0.06]">
                    <a
                      class="group grid grid-cols-1 sm:grid-cols-[5.5rem_minmax(0,1fr)] gap-x-6 gap-y-1 py-5 sm:py-6 items-baseline"
                      href={serviceUrl(s.slug)}
                    >
                      <span class="text-xs font-mono font-semibold tracking-widest text-brand-crimson">{s.code}</span>
                      <span class="min-w-0">
                        <span class="flex items-baseline justify-between gap-4">
                          <span class="text-base sm:text-lg font-semibold tracking-tight text-neutral-800 group-hover:text-brand-crimson transition-colors">
                            {s.title}
                          </span>
                          <span class="shrink-0 text-sm text-neutral-400 group-hover:text-brand-crimson transition-colors" aria-hidden="true">
                            →
                          </span>
                        </span>
                        <span class="block mt-1 text-sm leading-relaxed text-neutral-600 max-w-2xl">{s.summary}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>

    <div class="mt-12 sm:mt-16 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-8 border-t border-black/[0.08]">
      <p class="text-xs font-mono text-neutral-500">Código transferido · EU-hosted · RGPD · AI Act UE</p>
      <a
        class="inline-flex items-center gap-2 min-h-[44px] text-sm font-semibold text-neutral-800 hover:text-brand-crimson transition-colors"
        href="/servicios"
      >
        Ver el catálogo completo
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
