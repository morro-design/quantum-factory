---
import '../styles/global.css';
import { site, organizationJsonLd, websiteJsonLd } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path (e.g. "/servicios/foo") — resolved against Astro.site. Defaults to current URL. */
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  keywords?: string[];
  /** Extra JSON-LD objects appended after Organization + WebSite. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  canonical,
  ogType = 'website',
  ogImage = site.ogImage,
  noindex = false,
  keywords = site.keywords,
  jsonLd = [],
} = Astro.props;

const base = Astro.site ?? new URL(site.url);
const path = canonical ?? Astro.url.pathname;
const canonicalUrl = new URL(path.replace(/\/$/, '') || '/', base).href;
const ogImageUrl = new URL(ogImage, base).href;

const schemas = [organizationJsonLd, websiteJsonLd, ...jsonLd];
---

<!doctype html>
<html class="scroll-smooth" lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts: Plus Jakarta Sans & Space Grotesk -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body
    class="bg-brand-midnight text-white font-sans antialiased selection:bg-brand-lima selection:text-black overflow-x-hidden font-feature-settings"
  >
    <slot />
  </body>
</html>
